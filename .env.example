# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Antideploy sets this automatically when the project has a Postgres database.
# Locally, use your own Postgres 17+ database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/animepahe

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Antideploy supplies PORT when it runs the app. 3000 is a safe local default.
PORT=3000
NODE_ENV=development
# Comma-separated allowed browser origins. Leave empty for no CORS headers.
# Do not use * on a public deployment unless you truly intend to allow every site.
CORS_ORIGINS=
# Set to true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=90
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Upstream metadata providers
# ---------------------------------------------------------------------------
# AniList needs no key. This is the public GraphQL endpoint.
ANILIST_API_URL=https://graphql.anilist.co

# TMDB is optional but strongly recommended. Use EITHER a v3 API key
# OR a v4 read access token. Never commit either value.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ---------------------------------------------------------------------------
# Cache (seconds)
# ---------------------------------------------------------------------------
SEARCH_CACHE_TTL=300
ANIME_CACHE_TTL=21600
EPISODE_CACHE_TTL=21600
MATCH_CACHE_TTL=86400
SOURCES_CACHE_TTL=60
SUBTITLES_CACHE_TTL=120
STALE_CACHE_TTL=604800
MEMORY_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Network behaviour
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_MS=8000
HTTP_MAX_CONCURRENCY=6
HTTP_RETRIES=2

# ---------------------------------------------------------------------------
# Authorized source catalogue
# ---------------------------------------------------------------------------
# The catalogue provider never scrapes or bypasses access controls. Operators add
# sources they are authorized to provide with: npm run source:add
# (The optional AnimePahe provider is configured separately below.)
SOURCE_CATALOG_ENABLED=true

# ---------------------------------------------------------------------------
# Source provider isolation
# ---------------------------------------------------------------------------
# Each provider is called inside this budget. A hung provider is reported as a
# warning instead of delaying the whole response. Minimum 1000, maximum 120000.
SOURCE_PROVIDER_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Optional AnimePahe provider
# ---------------------------------------------------------------------------
# Disabled by default. Enable only if you are authorized to serve these links
# and accept the upstream site's terms, availability and rate limits. The
# provider never bypasses Cloudflare, CAPTCHAs, logins or DRM, and it never
# downloads files: DL links are resolved to normal playable stream URLs.
SOURCE_ANIMEPAHE_ENABLED=false
ANIMEPAHE_BASE_URL=https://animepahe.pw
# Optional browser User-Agent override. Leave empty for the built-in default.
ANIMEPAHE_USER_AGENT=
ANIMEPAHE_DEADLINE_MS=45000
ANIMEPAHE_MAX_SEARCH_PAGES=2
ANIMEPAHE_MAX_DOWNLOAD_OPTIONS=4
