{
  "name": "animepahe-api",
  "version": "1.0.0",
  "private": true,
  "description": "Independent anime metadata and source API for Nuvio and other clients",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "source:add": "tsx scripts/add-source.ts",
    "subtitle:add": "tsx scripts/add-subtitle.ts",
    "subtitle:inspect": "tsx scripts/inspect-subtitle.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
